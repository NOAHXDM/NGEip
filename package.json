{
  "name": "angular-eip",
  "version": "4.5.3",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "generate:messaging-sw": "node tools/generate-firebase-messaging-sw.mjs",
    "prestart": "npm run functions:build",
    "prebuild": "npm run generate:messaging-sw",
    "prewatch": "npm run generate:messaging-sw",
    "start": "firebase emulators:start --config firebase.local.json --import ./firestore-backup",
    "build": "ng build",
    "functions:build": "npm --prefix functions run build",
    "deploy": "npm run build && firebase deploy --config firebase.prod.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --browsers=ChromeHeadlessNoSandbox",
    "functions:test": "npm --prefix functions test",
    "test:jsm-weekly-deployment": "npm run functions:build && node --test tools/jsm-weekly-deployment-tests.cjs",
    "test:jsm-weekly": "npm run functions:build && firebase emulators:exec --config firebase.weekly-test.json --project demo-jsm-weekly --only firestore \"node --test tools/jsm-weekly-emulator-tests.cjs\"",
    "test:debug": "ng test --browsers=Chrome",
    "test:attachment-audit": "node --test tools/request-attachment-orphan-audit.test.js",
    "test:attachment-rules": "firebase emulators:exec --config firebase.local.json --project demo-request-attachments --only firestore,storage \"node tools/request-attachment-emulator-tests.cjs\"",
    "test:attendance-rules": "firebase emulators:exec --config firebase.local.json --project demo-attendance-permission --only firestore \"node tools/attendance-permission-emulator-tests.cjs\"",
    "test:journey-rules": "firebase emulators:exec --config firebase.local.json --project demo-user-journey --only firestore,storage \"node tools/journey-event-emulator-tests.cjs\"",
    "test:journey-integration": "firebase emulators:exec --config firebase.local.json --project demo-user-journey-angular --only firestore \"npx ng test --watch=false --browsers=ChromeHeadlessNoSandbox --include='src/app/journey-timeline/testing/us1-integration.spec.ts' --karma-config=karma.journey-integration.conf.cjs\"",
    "audit:request-attachments": "node tools/request-attachment-orphan-audit.js",
    "audit:request-attachments:local": "node tools/request-attachment-orphan-audit.js --fixture src/app/attachments/testing/orphan-audit-fixture.json",
    "test:evaluation-integration": "firebase emulators:exec --config firebase.local.json --project demo-evaluation-angular --only firestore \"npx ng test --watch=false --browsers=ChromeHeadlessNoSandbox --include='src/app/evaluation/testing/*.spec.ts' --karma-config=karma.evaluation-integration.conf.cjs\""
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/fire": "^21.0.0",
    "@angular/forms": "^21.2.26",
    "@angular/material": "^21.2.14",
    "@angular/material-date-fns-adapter": "^21.2.14",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@ng-matero/extensions": "^21.3.1",
    "@ng-matero/extensions-date-fns-adapter": "^21.0.0",
    "bootstrap": "^5.3.3",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.26",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^25.5.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3"
  }
}
